<Window x:Class="Win11Inspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win11 Inspector"
        Width="1050"
        Height="760"
        MinWidth="850"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Margin="0,0,0,24">

            <StackPanel>

                <TextBlock Text="Win11 Inspector"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>

                <TextBlock Text="Windows 11 Compatibility Assistant"
                           FontSize="14"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"/>

            </StackPanel>

            <Button DockPanel.Dock="Right"
                    Content="â†»  Skanuj ponownie"
                    Click="Rescan_Click"
                    VerticalAlignment="Center"/>

        </DockPanel>

        <Border Grid.Row="1"
                Background="{StaticResource CardBrush}"
                CornerRadius="20"
                Padding="25"
                Margin="0,0,0,18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock x:Name="DeviceText"
                               Text="Analizowanie urzÄ…dzenia..."
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock x:Name="SummaryText"
                               Margin="0,9,0,0"
                               FontSize="14"
                               Foreground="{StaticResource SecondaryTextBrush}"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center">

                    <TextBlock x:Name="ScoreText"
                               Text="â€”"
                               FontSize="46"
                               FontWeight="Bold"
                               Foreground="{StaticResource BlueBrush}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="gotowoĹ›Ä‡"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl x:Name="ResultList">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Background="{StaticResource CardBrush}"
                                CornerRadius="15"
                                Padding="18"
                                Margin="0,0,0,10">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="â—Ź"
                                           FontSize="18">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Foreground"
                                                    Value="{StaticResource GreenBrush}"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding State}"
                                                             Value="Warning">

                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource OrangeBrush}"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding State}"
                                                             Value="Fail">

                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource RedBrush}"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Value}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding Details}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

        <DockPanel Grid.Row="3"
                   Margin="0,18,0,0">

            <TextBlock x:Name="FooterText"
                       Text="Diagnostyka lokalna â€˘ dane nie sÄ… wysyĹ‚ane do internetu"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       VerticalAlignment="Center"/>

            <Button DockPanel.Dock="Right"
                    Content="Przygotuj instalacjÄ™ Windows 11"
                    Click="Prepare_Click"
                    Margin="15,0,0,0"/>

        </DockPanel>

    </Grid>

</Window>